                <TextBlock Grid.Row="5" x:Name="PackageStatusText" Text="Ready. User-scoped, supported packages only. No bulk updates." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
