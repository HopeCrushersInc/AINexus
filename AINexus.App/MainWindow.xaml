<Window x:Class="AINexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AINexus.App"
        Title="AI Nexus Portal" Height="820" Width="1280"
        MinHeight="650" MinWidth="950" Background="#090D16" Foreground="#E6F7FF"
        FontFamily="Consolas" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111A29"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26394E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4DEBFF"/>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CA6BC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8CA6BC"/>
            <Setter Property="Background" Value="#111A29"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#315A6D" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#4DEBFF"/>
                                <Setter Property="Background" Value="#153443"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <TabControl Margin="12" Background="#090D16" Foreground="#E6F7FF" BorderBrush="#26394E">
        <TabItem x:Name="DiscoveryTab" Header="Discover AI" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="FIND AI FOR THIS COMPUTER" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Scan hardware → Search online → Compare resources → Review installation → Verify → Run offline" Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="DiscoveryScanButton" Content="SCAN THIS PC" DockPanel.Dock="Right" Click="DiscoveryScanButton_Click" Padding="14,8" Margin="12,0,0,0"/>
                    <TextBlock x:Name="DiscoveryHardwareText" Text="Scan this PC to use actual hardware, driver evidence, and available storage." TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="INTEREST" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveryInterestSelector" DisplayMemberPath="Name" SelectionChanged="DiscoveryInterestSelector_SelectionChanged" Padding="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="SEARCH TERMS (OPTIONAL)" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <TextBox x:Name="DiscoveryQueryText" Padding="8" MaxLength="160" ToolTip="Model or publisher terms, for example Qwen2.5 GGUF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="MODEL STORAGE VOLUME" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveryVolumeSelector" DisplayMemberPath="Path" SelectionChanged="DiscoveryVolumeSelector_SelectionChanged" Padding="8"/>
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="3" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="DiscoverySearchButton" Content="SEARCH ONLINE" Click="DiscoverySearchButton_Click" Padding="12,8"/>
                        <Button x:Name="DiscoverySavedButton" Content="LOAD SAVED SEARCH" Click="DiscoverySavedButton_Click" Padding="12,8" Margin="8,0,0,0"/>
                        <Button x:Name="DiscoveryCancelButton" Content="CANCEL" Click="DiscoveryCancelButton_Click" Padding="12,8" Margin="8,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="DiscoveryScopeText" TextWrapping="Wrap" Foreground="#8CA6BC" VerticalAlignment="Center"/>
                </DockPanel>
                <DataGrid Grid.Row="4" x:Name="DiscoveryResultsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DiscoveryResultsGrid_SelectionChanged" Background="#111A29" Foreground="#111A29" HeadersVisibility="Column" EnableRowVirtualization="True" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Candidate" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="*"/>
                        <DataGridTextColumn Header="Artifact GiB" Binding="{Binding SizeDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Declared license" Binding="{Binding LicenseDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Assessment" Binding="{Binding StatusDisplay}" Width="1.2*"/>
                        <DataGridTextColumn Header="Execution path" Binding="{Binding ExecutionPath}" Width="1.5*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox Grid.Row="5" x:Name="DiscoveryDetailsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111A29" Foreground="#E6F7FF" Padding="12" Text="Select a result to review its source evidence, requirement estimate, assumptions, and unknowns. No software is installed by discovery."/>
                <StackPanel Grid.Row="6" Margin="0,10,0,0">
                <DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RuntimeReleaseLookupButton" Content="LOOK UP RELEASE" Click="RuntimeReleaseLookupButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                        <Button x:Name="RuntimeReleaseSavedButton" Content="LOAD SAVED RELEASE" Click="RuntimeReleaseSavedButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="EXPLICIT RELEASE TAG" VerticalAlignment="Center" Foreground="#8CA6BC" Margin="0,0,8,0"/>
                    <TextBox x:Name="RuntimeReleaseTagText" Padding="8" MaxLength="128" ToolTip="Enter an exact upstream llama.cpp release tag. No latest or nightly fallback is selected."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="NEW RUNTIME FOLDER" VerticalAlignment="Center" Foreground="#8CA6BC" Margin="0,0,8,0"/>
                    <Button x:Name="RuntimeSetupReviewButton" DockPanel.Dock="Right" Content="REVIEW RUNTIME SETUP" Click="RuntimeSetupReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <TextBox x:Name="RuntimeDestinationText" Padding="8" TextChanged="RuntimeDestinationText_TextChanged" ToolTip="New runtime folder on the assessed volume; existing folders cannot be used"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="RuntimeFileReviewButton" DockPanel.Dock="Right" Content="REVIEW SELECTED FILES" Click="RuntimeFileReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button x:Name="RuntimeInspectButton" DockPanel.Dock="Right" Content="INSPECT LOCAL ZIP FILES" Click="RuntimeInspectButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <TextBlock DockPanel.Dock="Left" Text="RUNTIME ARCHIVE" VerticalAlignment="Center" Foreground="#8CA6BC" Margin="0,0,8,0"/>
                    <ComboBox x:Name="RuntimeArchiveSelector" DisplayMemberPath="Name" SelectionChanged="RuntimeArchiveSelector_SelectionChanged" IsEnabled="False" Padding="8" ToolTip="Explicitly select a published runtime archive; no archive is chosen automatically"/>
                </DockPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DiscoveryDestinationText" Padding="8" ToolTip="Model destination folder on the assessed volume" TextChanged="DiscoveryDestinationText_TextChanged"/>
                    <Button Grid.Column="1" Content="CHOOSE FOLDER" Click="DiscoveryChooseFolderButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" x:Name="DiscoveryPlanButton" Content="REVIEW DOWNLOAD PLAN" Click="DiscoveryPlanButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" x:Name="DiscoveryVerifyButton" Content="VERIFY EXISTING FILE" Click="DiscoveryVerifyButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                </Grid>
                </StackPanel>
                <Grid Grid.Row="7" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <CheckBox x:Name="AcquisitionApprovalCheck" IsEnabled="False" Foreground="#E6F7FF" Checked="AcquisitionApprovalChanged" Unchecked="AcquisitionApprovalChanged">
                            <TextBlock Text="I approve this exact model-data plan and destination, and accept its source license terms." TextWrapping="Wrap"/>
                        </CheckBox>
                        <ProgressBar x:Name="AcquisitionProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,6,0,0" Value="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="AcquisitionDownloadButton" Content="DOWNLOAD APPROVED MODEL" Click="AcquisitionDownloadButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" x:Name="AcquisitionLibraryButton" Content="ADD TO LIBRARY" Click="AcquisitionLibraryButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="8" x:Name="DiscoveryStatusText" Text="Online search reads public metadata only. Hardware evaluation stays on this PC. Installation, builds, and remote-server access require separate approval." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Hardware" Padding="18,10">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="AI NEXUS" FontSize="13" Foreground="#4DEBFF" FontWeight="Bold"/>
                <TextBlock Text="SYSTEM OVERVIEW" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock Text="Live machine profile - local AI readiness" Foreground="#8CA6BC" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="PHASE 01 / HARDWARE DISCOVERY" Foreground="#4DEBFF" HorizontalAlignment="Right"/>
                <TextBlock x:Name="ScanStatusText" Text="INITIALIZING SCAN..." Foreground="#8CA6BC" Margin="0,8,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="PROCESSOR" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="CpuText" Text="Scanning..." Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Detected via Windows CIM" Foreground="#71889B" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="SYSTEM MEMORY" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="RamText" Text="Scanning..." Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Installed physical RAM" Foreground="#71889B" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="GRAPHICS ADAPTERS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="GpuCountText" Text="Scanning..." Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="VRAM reported when available" Foreground="#71889B" FontSize="11" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="GPU INVENTORY" FontSize="15" FontWeight="Bold" Foreground="#4DEBFF" Margin="0,0,0,16"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="GpuList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0B121E" BorderBrush="#26394E" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="14" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding VramDisplay}" Foreground="#8CA6BC" Margin="0,6,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="FIXED STORAGE" FontSize="15" FontWeight="Bold" Foreground="#4DEBFF" Margin="0,0,0,16"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="StorageList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,16">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="13"/>
                                            <TextBlock Text="{Binding FreeDisplay}" Foreground="#4DEBFF" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                                        </DockPanel>
                                        <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100" Value="{Binding FreePercent, Mode=OneWay}" Background="#26394E" Foreground="#4DEBFF" BorderThickness="0"/>
                                        <TextBlock Text="{Binding CapacityDisplay}" Foreground="#71889B" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeText" Text="Hardware discovery runs locally on this machine." Foreground="#71889B" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <Button x:Name="HardwareRescanButton" Grid.Column="1" Content="RESCAN HARDWARE" Click="RescanButton_Click" Padding="18,10" Margin="12,0,0,0" Background="#153443" Foreground="#4DEBFF" BorderBrush="#315A6D" FontFamily="Consolas" Cursor="Hand"/>
        </Grid>
    </Grid>
        </TabItem>
        <TabItem Header="AI Software" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16" LastChildFill="True">
                    <Button x:Name="SoftwareRescanButton" DockPanel.Dock="Right" Content="RESCAN SOFTWARE" Click="SoftwareRescanButton_Click" Padding="18,10" Background="#153443" Foreground="#4DEBFF" BorderBrush="#315A6D"/>
                    <StackPanel>
                        <TextBlock Text="AI SOFTWARE DISCOVERY" FontSize="24" FontWeight="Bold" Foreground="#E6F7FF"/>
                        <TextBlock x:Name="SoftwareStatusText" Text="Waiting for discovery" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>
                <TextBlock Grid.Row="1" x:Name="SoftwareScopeText" Text="Checking registered installations and known executable locations." TextWrapping="Wrap" Foreground="#8CA6BC" Margin="0,0,0,16"/>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SoftwareList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Status}" DockPanel.Dock="Right" Foreground="#4DEBFF" Margin="16,0,0,0"/>
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Foreground="#E6F7FF"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Category}" Foreground="#8CA6BC" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Version, StringFormat=Version: {0}}" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Foreground="#E6F7FF" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" Foreground="#8CA6BC" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Grid.Row="3" x:Name="SoftwareNoticeText" Text="Discovery is read-only. Tools are not launched or installed." TextWrapping="Wrap" Foreground="#8CA6BC" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Live Resources" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,20">
                    <CheckBox x:Name="MonitoringEnabled" DockPanel.Dock="Right" Content="Live monitoring" IsChecked="True" Foreground="#E6F7FF" VerticalAlignment="Center"/>
                    <StackPanel>
                        <TextBlock Text="LIVE RESOURCE USAGE" FontSize="24" FontWeight="Bold"/>
                        <TextBlock x:Name="ResourceStatusText" Text="Waiting for first sample" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                    </StackPanel>
                </DockPanel>
                <UniformGrid Grid.Row="1" Columns="2">
                    <Border Style="{StaticResource PanelStyle}">
                        <StackPanel>
                            <TextBlock Text="CPU UTILIZATION" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="CpuUsageText" Text="Sampling..." Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock Text="Interval-based Windows processor time" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PHYSICAL MEMORY IN USE" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="MemoryUsageText" Text="Sampling..." Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock x:Name="MemoryAvailableText" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Border Grid.Row="2" Style="{StaticResource PanelStyle}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="NVIDIA GPU UTILIZATION / VRAM" FontSize="16" Foreground="#4DEBFF" Margin="0,0,0,16"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="GpuUsageList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="{Binding Name}" FontSize="16"/>
                                            <TextBlock Text="{Binding UsageDisplay}" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                                            <TextBlock Text="{Binding MemoryDisplay}" Foreground="#8CA6BC" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
                <TextBlock Grid.Row="3" x:Name="ResourceNoticeText" Text="Samples every 2 seconds. Monitoring does not impose resource limits. GPU metrics require the NVIDIA driver utility." TextWrapping="Wrap" Foreground="#8CA6BC" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="PackageTab" Header="Install / Update" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="AI APPLICATION INSTALLER" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="PackageSelector" DisplayMemberPath="Name" SelectionChanged="PackageSelector_SelectionChanged" Padding="10"/>
                    <Button x:Name="PackagePreviewButton" Grid.Column="1" Content="REVIEW PACKAGE" Click="PackagePreviewButton_Click" Padding="18,10" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="PackagePlanText" Text="Choose a package and review its current WinGet metadata." TextWrapping="Wrap" Foreground="#8CA6BC" Margin="0,0,0,12"/>
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <CheckBox x:Name="PackageAgreementCheck" Content="I accept the displayed package license terms and WinGet source agreements for this operation." Foreground="#E6F7FF" IsEnabled="False" Checked="PackageAgreementChanged" Unchecked="PackageAgreementChanged"/>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="PackageInstallButton" Content="INSTALL FOR CURRENT USER" Click="PackageInstallButton_Click" IsEnabled="False" Padding="18,10"/>
                        <Button x:Name="PackageUpdateButton" Content="UPDATE FOR CURRENT USER" Click="PackageUpdateButton_Click" IsEnabled="False" Padding="18,10" Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBox Grid.Row="4" x:Name="PackageOutputText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#111A29" Foreground="#E6F7FF" BorderBrush="#26394E" Padding="12" Text="Package review contacts the WinGet community source. No application is installed until you choose Install or Update."/>
                <TextBlock Grid.Row="5" x:Name="PackageStatusText" Text="Ready. User-scoped, supported packages only. No bulk updates." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Model Files" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <Button x:Name="LibraryRescanButton" DockPanel.Dock="Right" Content="RESCAN FOLDERS" Click="LibraryRescanButton_Click" Padding="18,10"/>
                    <TextBlock Text="LOCAL MODEL LIBRARY" FontSize="24" FontWeight="Bold"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="LibraryRootSelector" Padding="10"/>
                    <Button Grid.Column="1" x:Name="LibraryAddButton" Content="ADD FOLDER" Click="LibraryAddButton_Click" Padding="12,10" Margin="12,0,0,0"/>
                    <Button Grid.Column="2" x:Name="LibraryRemoveButton" Content="STOP TRACKING" Click="LibraryRemoveButton_Click" Padding="12,10" Margin="12,0,0,0"/>
                </Grid>
                <TextBlock Grid.Row="2" x:Name="LibraryStatusText" Text="Add a model folder to index GGUF, SafeTensors, and ONNX files." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <DataGrid Grid.Row="3" x:Name="ModelFileGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="#111A29" Foreground="#111A29" BorderBrush="#26394E" HeadersVisibility="Column" EnableRowVirtualization="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model file" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="Auto"/>
                        <DataGridTextColumn Header="GiB" Binding="{Binding SizeDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding FullPath}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Grid.Row="4" x:Name="LibraryNoticeText" Text="Indexing reads file metadata only. Stop tracking removes a folder from this list; model files remain on disk. File format labels come from extensions and do not validate model contents." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="LlamaCppTab" Header="llama.cpp" Padding="18,10" Loaded="LlamaCppTab_Loaded">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="PORTABLE LLAMA.CPP" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                <Border Grid.Row="1" Background="#111A29" BorderBrush="#26394E" BorderThickness="1" Padding="12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <Button x:Name="LlamaCppBrowseExecutableButton" DockPanel.Dock="Right" Content="BROWSE SERVER" Click="LlamaCppBrowseExecutableButton_Click" Padding="10,6" Margin="8,0,0,0"/>
                            <TextBox x:Name="LlamaCppExecutableText" Padding="6" ToolTip="Full path to portable llama-server.exe"/>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                            <Button x:Name="LlamaCppBrowseModelButton" DockPanel.Dock="Right" Content="BROWSE GGUF" Click="LlamaCppBrowseModelButton_Click" Padding="10,6" Margin="8,0,0,0"/>
                            <TextBox x:Name="LlamaCppModelPathText" Padding="6" ToolTip="Existing GGUF model loaded when you explicitly start the server"/>
                        </DockPanel>
                        <DockPanel Grid.Row="2" Margin="0,0,0,8">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="LlamaCppStartButton" Content="START OWNED SERVER" Click="LlamaCppStartButton_Click" Padding="10,6"/>
                                <Button x:Name="LlamaCppStopButton" Content="STOP OWNED SERVER" Click="LlamaCppStopButton_Click" Padding="10,6" Margin="8,0,0,0" IsEnabled="False" ToolTip="Cancels llama.cpp agent tasks and stops only the server started by this portal"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Port" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="LlamaCppPortText" Text="8080" Width="70" Padding="6" MaxLength="5"/>
                                <TextBlock Text="Context tokens" VerticalAlignment="Center" Margin="12,0,6,0"/>
                                <TextBox x:Name="LlamaCppContextText" Text="4096" Width="90" Padding="6" MaxLength="8" ToolTip="Requested context size; actual memory use depends on model, build, and hardware"/>
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Grid.Row="3" x:Name="LlamaCppRuntimeStatusText" Text="Select a portable server and existing GGUF. Start explicitly loads the model in a hidden server process. Only a server started by this portal stops on close; other local servers are preserved." Foreground="#8CA6BC" TextWrapping="Wrap"/>
                    </Grid>
                </Border>
                <DockPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button x:Name="LlamaCppRefreshButton" DockPanel.Dock="Right" Content="QUERY LOCAL SERVER" Click="LlamaCppRefreshButton_Click" Padding="18,10" Margin="12,0,0,0"/>
                    <TextBox x:Name="LlamaCppEndpointText" Text="http://127.0.0.1:8080" Padding="10" ToolTip="Loopback HTTP or HTTPS root address of an existing llama-server"/>
                </DockPanel>
                <TextBlock Grid.Row="3" x:Name="LlamaCppStatusText" Text="No server queried yet. Connect to an existing local llama.cpp server to read its actual model IDs." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <ListBox Grid.Row="4" x:Name="LlamaCppModelList" Background="#111A29" Foreground="#E6F7FF" BorderBrush="#26394E" Padding="10" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
                <Expander Grid.Row="5" Header="Owned server output" Foreground="#8CA6BC" Margin="0,8,0,0">
                    <DockPanel>
                        <Button x:Name="LlamaCppLogButton" DockPanel.Dock="Top" Content="REFRESH OUTPUT" Click="LlamaCppLogButton_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,0,0,6"/>
                        <TextBox x:Name="LlamaCppRuntimeLogText" Height="90" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111A29" Foreground="#E6F7FF"/>
                    </DockPanel>
                </Expander>
                <TextBlock Grid.Row="6" Text="Query only reads /v1/models. Start loads your selected model; no downloads or global installation occur. Choose an actual returned model ID in Agent Tasks to send a prompt." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Ollama Models" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="OLLAMA MODEL INVENTORY" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="OllamaRefreshButton" DockPanel.Dock="Right" Content="QUERY LOCAL SERVER" Click="OllamaRefreshButton_Click" Padding="18,10" Margin="12,0,0,0"/>
                    <TextBox x:Name="OllamaEndpointText" Text="http://127.0.0.1:11434" Padding="10" ToolTip="Loopback HTTP or HTTPS endpoint only"/>
                </DockPanel>
                <TextBlock Grid.Row="2" x:Name="OllamaStatusText" Text="No server queried yet. The portal does not start Ollama." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TabControl Grid.Row="3" Background="#090D16" Foreground="#E6F7FF" BorderBrush="#26394E">
                    <TabItem Header="Available models" Padding="12,8">
                        <DataGrid x:Name="OllamaAvailableGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="#111A29" Foreground="#111A29" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Disk GiB" Binding="{Binding SizeDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Parameters" Binding="{Binding ParameterDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Quantization" Binding="{Binding QuantizationDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Loaded models" Padding="12,8">
                        <DataGrid x:Name="OllamaRunningGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="#111A29" Foreground="#111A29" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Loaded GiB" Binding="{Binding SizeDisplay}" Width="*"/>
                                <DataGridTextColumn Header="VRAM GiB" Binding="{Binding VramDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="4" x:Name="OllamaNoticeText" Text="Read-only queries to /api/tags and /api/ps. No model downloads, inference, or load/unload operations." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="EmbeddedTab" Header="Embedded Apps" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="LOCAL APPLICATION INTERFACE" FontSize="24" FontWeight="Bold" Margin="0,0,0,16"/>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="EmbeddedOpenButton" DockPanel.Dock="Right" Content="OPEN IN PORTAL" Click="EmbeddedOpenButton_Click" Padding="18,10" Margin="12,0,0,0"/>
                    <TextBox x:Name="EmbeddedEndpointText" Padding="10" ToolTip="Enter the loopback URL of an existing local AI web interface"/>
                </DockPanel>
                <local:EmbeddedAppHost Grid.Row="2" x:Name="EmbeddedHost"/>
                <TextBlock Grid.Row="3" x:Name="EmbeddedStatusText" Text="Enter the address of an existing local web interface. The portal does not start a server. Downloads and new windows are blocked." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem Header="Agent Tasks" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="AgentRefreshModelsButton" DockPanel.Dock="Right" Content="REFRESH LOCAL MODELS" Click="AgentRefreshModelsButton_Click" Padding="12,8"/>
                    <TextBlock Text="LOCAL AGENT TASKS" FontSize="24" FontWeight="Bold"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="AgentRuntimeSelector" Padding="8" Margin="0,0,12,0" DisplayMemberPath="Name" SelectionChanged="AgentRuntimeSelector_SelectionChanged" ToolTip="Runtime retained by each queued task"/>
                    <TextBox x:Name="AgentNameText" Grid.Column="1" Text="Local task" Padding="8" Margin="0,0,12,0" ToolTip="Task name" MaxLength="120"/>
                    <ComboBox x:Name="AgentModelSelector" Grid.Column="2" Padding="8" SelectionChanged="AgentModelSelector_SelectionChanged" ToolTip="Select an actual model ID reported by the selected local runtime"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="SYSTEM INSTRUCTION" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <TextBox x:Name="AgentSystemText" Text="Complete the user's task using the information provided." AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" MaxLength="8192"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TASK PROMPT" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <TextBox x:Name="AgentPromptText" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" MaxLength="32768"/>
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="3" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="AgentEnqueueButton" Content="QUEUE TASK" Click="AgentEnqueueButton_Click" Padding="12,8" IsEnabled="False"/>
                        <Button Content="CANCEL SELECTED" Click="AgentCancelButton_Click" Padding="12,8" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Min free RAM GiB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="AgentMinRamText" Text="1" Width="48" Padding="5" MaxLength="12"/>
                        <TextBlock Text="Max CPU %" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="AgentMaxCpuText" Text="95" Width="48" Padding="5" MaxLength="12"/>
                        <TextBlock Text="Min free VRAM GiB (0=off)" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="AgentMinVramText" Text="0" Width="48" Padding="5" MaxLength="12"/>
                    </WrapPanel>
                </DockPanel>
                <DataGrid Grid.Row="4" x:Name="AgentJobGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="AgentJobGrid_SelectionChanged" Background="#111A29" Foreground="#111A29" HeadersVisibility="Column" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="Auto"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox Grid.Row="5" x:Name="AgentOutputText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111A29" Foreground="#E6F7FF" Padding="10"/>
                <TextBlock Grid.Row="6" x:Name="AgentStatusText" Text="Refresh local models, choose a model, and enter a prompt. Serial requests use resource admission checks, not OS quotas. Prompts and replies stay in this session. No model output is executed as code or tools." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="OfflineVerificationTab" Header="Verify Offline" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="VERIFY A LOCAL MODEL" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Audit the saved artifact first, then explicitly test a selected local runtime. A checksum match alone does not prove inference works." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="OfflineReceiptBrowseButton" DockPanel.Dock="Right" Content="CHOOSE RECEIPT" Click="OfflineReceiptBrowseButton_Click" Padding="12,8" Margin="10,0,0,0"/>
                    <TextBox x:Name="OfflineReceiptText" Padding="8" ToolTip="Acquisition receipt under the model folder's .ainexus/receipts" TextChanged="OfflineInputChanged"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button x:Name="OfflineRuntimeBrowseButton" DockPanel.Dock="Right" Content="CHOOSE RUNTIME" Click="OfflineRuntimeBrowseButton_Click" Padding="12,8" Margin="10,0,0,0"/>
                    <TextBox x:Name="OfflineRuntimeText" Padding="8" ToolTip="Existing local llama-server.exe; no installer will be launched" TextChanged="OfflineInputChanged"/>
                </DockPanel>
                <WrapPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Context tokens" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="OfflineContextText" Text="4096" Width="70" Padding="7" MaxLength="8" TextChanged="OfflineInputChanged"/>
                    <Button x:Name="OfflineAuditButton" Content="AUDIT FILE INTEGRITY" Click="OfflineAuditButton_Click" IsEnabled="False" Padding="12,8" Margin="12,0,0,0"/>
                    <Button x:Name="OfflineRunButton" Content="RUN LOCAL SMOKE TEST (LOADS MODEL)" Click="OfflineRunButton_Click" IsEnabled="False" Padding="12,8" Margin="12,0,0,0"/>
                    <Button x:Name="OfflineCancelButton" Content="CANCEL" Click="OfflineCancelButton_Click" Padding="12,8" Margin="12,0,0,0" IsEnabled="False"/>
                </WrapPanel>
                <TextBox Grid.Row="4" x:Name="OfflineEvidenceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#111A29" Foreground="#E6F7FF" Padding="12" Text="An approved acquisition supplies a receipt automatically. You can also choose a saved receipt. Auditing reads local files only; running the smoke test temporarily loads the model and stops its own server afterward."/>
                <TextBlock Grid.Row="5" x:Name="OfflineStatusText" Text="No verification has run. No model or runtime is required to use online discovery." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
    </TabControl>
</Window>

