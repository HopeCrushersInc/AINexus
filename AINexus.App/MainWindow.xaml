                <TextBlock Text="Choose a task. You're in control." TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,22"/>
                <TextBlock x:Name="StoreSetupNoticeText" Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" FontSize="{DynamicResource NexusFontSize12}" Margin="0,0,0,18"/>
                <Button Content="Find models &amp; tools" Tag="DiscoveryTab" Click="StoreNavigate_Click" Margin="0,0,0,8"/>
