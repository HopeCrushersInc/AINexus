                <Button Content="Downloads &amp; setup" Tag="DownloadsTab" Click="StoreNavigate_Click" Margin="0,0,0,8"/>
                <Button Content="Chat" Tag="ChatTab" Click="StoreNavigate_Click" Margin="0,0,0,8"/>
                <Button Content="Performance &amp; power" Tag="ResourcesTab" Click="StoreNavigate_Click" Margin="0,0,0,8"/>
