<Window x:Class="AINexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AINexus.App"
        Title="AI Nexus Portal" Height="900" Width="1440"
        MinHeight="650" MinWidth="950" Background="#090D16" Foreground="#E6F7FF"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#182638"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26394E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#66C0F4"/>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8CA6BC"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#8CA6BC"/>
            <Setter Property="Background" Value="#182638"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="#315A6D" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="#66C0F4"/>
                                <Setter Property="Background" Value="#153443"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#28445D"/><Setter Property="Foreground" Value="#F4F8FC"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#3A6586"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#66C0F4"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#101C2A"/><Setter Property="Foreground" Value="#E6EEF8"/><Setter Property="BorderBrush" Value="#3A5068"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#172536"/><Setter Property="Background" Value="#DCE7F2"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGrid"><Setter Property="RowBackground" Value="#19283A"/><Setter Property="AlternatingRowBackground" Value="#1C2E41"/><Setter Property="Foreground" Value="#E6EEF8"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="48"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="#24374D"/><Setter Property="Foreground" Value="#B7C9DB"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Foreground" Value="#E6EEF8"/></Style>
        <Style x:Key="NavStyle" TargetType="RadioButton"><Setter Property="Foreground" Value="#AABFD4"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavSurface" Padding="18,13" CornerRadius="6" Background="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#24445D"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="#20364B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#131F2D" Padding="16,24"><DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="8,0,0,30"><TextBlock Text="AI NEXUS" FontSize="24" FontWeight="Bold" Foreground="#66C0F4"/><TextBlock Text="Your local AI workspace" Foreground="#829AB2" FontSize="12" Margin="0,5,0,0"/></StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Local first. Yours to control." Foreground="#6F879E" FontSize="11" Margin="8,20,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="StoreNavigation" Visibility="Collapsed">
                <RadioButton x:Name="HomeNav" Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Home" Tag="StoreHomeTab" IsChecked="True" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Discover" Tag="DiscoveryTab" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Library" Tag="LibraryTab" Click="StoreNavigate_Click"/>
                <TextBlock x:Name="CreateWorkspaceHeading" Text="CREATE" Foreground="#637E98" FontSize="11" Margin="18,25,0,7"/>
                <RadioButton x:Name="ImageWorkspaceNav" Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Images" Visibility="Collapsed" Tag="ImageStudioTab" Click="StoreNavigate_Click"/>
                <RadioButton x:Name="AssistantWorkspaceNav" Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Assistant" Visibility="Collapsed" Tag="AssistantTab" Click="StoreNavigate_Click"/>
                <TextBlock Text="MANAGE" Foreground="#637E98" FontSize="11" Margin="18,25,0,7"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Downloads &amp; setup" Tag="DownloadsTab" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Performance" Tag="ResourcesTab" Click="StoreNavigate_Click"/>
                <Expander Header="Advanced tools" Foreground="#829AB2" Margin="16,24,0,0"><StackPanel>
                    <Button Content="This computer" Tag="HardwareTab" Click="StoreNavigate_Click" Margin="0,8,0,4"/>
                    <Button Content="Installed tools" Tag="SoftwareTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Local model server" Tag="LlamaCppTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Ollama" Tag="OllamaTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Package manager" Tag="PackageTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Embedded apps" Tag="EmbeddedTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Offline checks" Tag="OfflineVerificationTab" Click="StoreNavigate_Click"/>
                </StackPanel></Expander>
            </StackPanel></ScrollViewer>
        </DockPanel></Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition/></Grid.RowDefinitions>
            <Border BorderBrush="#26394E" BorderThickness="0,0,0,1" Padding="28,18"><DockPanel><TextBlock DockPanel.Dock="Right" Text="ON YOUR COMPUTER" Foreground="#6F879E" FontSize="11" VerticalAlignment="Center"/><TextBlock x:Name="StorePageTitleText" Text="Home" FontSize="24" FontWeight="SemiBold"/></DockPanel></Border>
            <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="#101925" Foreground="#E6EEF8" BorderThickness="0" SelectionChanged="WorkspaceTabs_SelectionChanged">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}"><Grid><TabPanel IsItemsHost="True" Height="0" ClipToBounds="True" VerticalAlignment="Top"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/></Grid></Border></ControlTemplate></TabControl.Template>


        <TabItem x:Name="WorkloadSetupTab" Header="Set up your workspace"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
            <TextBlock Text="Let's build your AI workspace" FontSize="30" FontWeight="SemiBold"/>
            <TextBlock Text="Scan this computer → Choose your workloads → Review compatible tools → Approve downloads" Foreground="#AABFD4" TextWrapping="Wrap" Margin="0,12,0,24"/>
            <Border Style="{StaticResource PanelStyle}"><StackPanel>
                <DockPanel><Button x:Name="WorkloadRescanButton" DockPanel.Dock="Right" Content="Rescan hardware" Click="WorkloadRescanButton_Click" IsEnabled="False" Margin="12,0,0,0"/><TextBlock Text="1. Your hardware" FontSize="22" FontWeight="SemiBold"/></DockPanel>
                <ProgressBar x:Name="WorkloadScanProgress" IsIndeterminate="True" Height="4" Margin="0,16,0,12"/>
                <TextBlock x:Name="WorkloadHardwareText" Text="Waiting for the local hardware scan..." Foreground="#E6EEF8" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <TextBlock x:Name="WorkloadScanStatusText" Text="The hardware scan runs first. No downloads, installs or engines will start." Foreground="#AABFD4" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <StackPanel x:Name="WorkloadOptionsPanel" Visibility="Collapsed">
                <TextBlock Text="2. What would you like to do?" FontSize="24" FontWeight="SemiBold" Margin="0,6,0,8"/>
                <TextBlock Text="Choose one or more interests. This only shapes your workspace—it does not choose software for you or approve a download." Foreground="#AABFD4" TextWrapping="Wrap" Margin="0,0,0,16"/>
                <ItemsControl x:Name="WorkloadChoices"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                    <Border Style="{StaticResource PanelStyle}"><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="#E6EEF8" VerticalContentAlignment="Top"><StackPanel Margin="6,0,0,0"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="#AABFD4" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></CheckBox></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button x:Name="WorkloadContinueButton" Content="Build my workspace" Click="WorkloadContinueButton_Click" Background="#286E9A" HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,12"/>
                <TextBlock Text="You will choose specific tools and models next. Nothing is installed or loaded until you explicitly ask." Foreground="#829AB2" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="StoreHomeTab" Header="Home"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <Border CornerRadius="12" Padding="30" Margin="0,0,0,24"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#254A66" Offset="0"/><GradientStop Color="#17283A" Offset="1"/></LinearGradientBrush></Border.Background><StackPanel><TextBlock Text="Your workspace, your choices." FontSize="34" FontWeight="SemiBold"/><TextBlock Text="Find compatible options for your selected workloads. You decide what gets downloaded and installed." Foreground="#BCD0E2" FontSize="16" TextWrapping="Wrap" Margin="0,12,0,24"/><StackPanel Orientation="Horizontal"><Button Content="Find compatible options" Tag="DiscoveryTab" Click="StoreNavigate_Click" Background="#286E9A"/><Button Content="Change workloads" Click="ChangeWorkloadsButton_Click" Margin="12,0,0,0"/></StackPanel></StackPanel></Border>
            <TextBlock x:Name="StoreSetupNoticeText" Foreground="#AABFD4" TextWrapping="Wrap" Margin="0,0,0,20"/><TextBlock Text="Your selected workloads" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
            <ItemsControl x:Name="WorkspaceWorkloadCards"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource PanelStyle}"><StackPanel><TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Description}" Foreground="#AABFD4" TextWrapping="Wrap" Margin="0,12,0,20"/><Button Content="{Binding Action}" IsEnabled="{Binding Available}" Click="WorkloadCardAction_Click" HorizontalAlignment="Left"/></StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Style="{StaticResource PanelStyle}"><StackPanel><TextBlock Text="Your computer" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding Text, ElementName=CpuText}" Foreground="#AABFD4" Margin="0,12,0,4" TextWrapping="Wrap"/><TextBlock Text="{Binding Text, ElementName=SoftwareStatusText}" Foreground="#829AB2" TextWrapping="Wrap"/><Button Content="View library" Tag="LibraryTab" Click="StoreNavigate_Click" HorizontalAlignment="Left" Margin="0,16,0,0"/></StackPanel></Border>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="DownloadsTab" Header="Downloads &amp; setup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock Text="Review before installing" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Choose an item in Discover, then review its files, destination and requirements here." Foreground="#AABFD4" TextWrapping="Wrap" Margin="0,10,0,16"/>
            <TextBlock Text="{Binding Text, ElementName=StoreSelectionTitleText}" FontSize="20" Margin="0,0,0,12"/>
            <Expander x:Name="RuntimePackagesExpander" Header="Runtime packages (advanced)" Foreground="#AABFD4" Margin="0,0,0,16"><StackPanel Margin="0,10,0,0"><DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RuntimeReleaseLookupButton" Content="Look up release" Click="RuntimeReleaseLookupButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                        <Button x:Name="RuntimeReleaseSavedButton" Content="Load saved release" Click="RuntimeReleaseSavedButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="EXPLICIT RELEASE TAG" VerticalAlignment="Center" Foreground="#8CA6BC" Margin="0,0,8,0"/>
                    <TextBox x:Name="RuntimeReleaseTagText" Padding="8" MaxLength="128" ToolTip="Enter an exact upstream llama.cpp release tag. No latest or nightly fallback is selected."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="NEW RUNTIME FOLDER" VerticalAlignment="Center" Foreground="#8CA6BC" Margin="0,0,8,0"/>
                    <Button x:Name="RuntimeSetupReviewButton" DockPanel.Dock="Right" Content="Review runtime setup" Click="RuntimeSetupReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <TextBox x:Name="RuntimeDestinationText" Padding="8" TextChanged="RuntimeDestinationText_TextChanged" ToolTip="New runtime folder on the assessed volume; existing folders cannot be used"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="RUNTIME ARCHIVE" VerticalAlignment="Center" Foreground="#8CA6BC" Margin="0,0,8,0"/>
                    <ComboBox x:Name="RuntimeArchiveSelector" DisplayMemberPath="Name" SelectionChanged="RuntimeArchiveSelector_SelectionChanged" IsEnabled="False" Padding="8" ToolTip="Explicitly select a published runtime archive; no archive is chosen automatically"/>
                </DockPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="RuntimeFileReviewButton" Content="Review selected files" Click="RuntimeFileReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                    <Button x:Name="RuntimeInspectButton" Content="Inspect local zip files" Click="RuntimeInspectButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                    <Button x:Name="RuntimeInstallReviewButton" Content="Review local install" Click="RuntimeInstallReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                </WrapPanel>
                <Expander x:Name="RuntimeDownloadExpander" Header="Runtime archive download" Foreground="#AABFD4" Margin="0,4,0,12"><StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Single CPU runtime ZIP; installation approval is separate." Foreground="#AABFD4" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,6,0,6">
                        <Button x:Name="RuntimeDownloadBrowseButton" DockPanel.Dock="Right" Content="Choose download folder" Click="RuntimeDownloadBrowseButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                        <TextBox x:Name="RuntimeDownloadDirectoryText" Padding="8" TextChanged="RuntimeDownloadDirectoryChanged" ToolTip="Existing local folder for the exact reviewed ZIP; separate from the new installation folder"/>
                    </DockPanel>
                    <WrapPanel>
                        <Button x:Name="RuntimeDownloadReviewButton" Content="Review runtime download" Click="RuntimeDownloadReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeDownloadButton" Content="Download approved archive" Click="RuntimeDownloadButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeDownloadCancelButton" Content="Cancel download" Click="RuntimeDownloadCancelButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeDownloadedInspectButton" Content="Inspect downloaded archive" Click="RuntimeDownloadedInspectButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <CheckBox x:Name="RuntimeDownloadApprovalCheck" Foreground="#E6EEF8" IsEnabled="False" Checked="RuntimeDownloadApprovalChanged" Unchecked="RuntimeDownloadApprovalChanged">
                        <TextBlock Text="I approve this exact runtime ZIP and download folder, accept its declared runtime license, and understand bundled terms need separate review before installation." TextWrapping="Wrap"/>
                    </CheckBox>
                    <ProgressBar x:Name="RuntimeDownloadProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,8,0,0"/>
                </StackPanel></Expander>
                <StackPanel x:Name="RuntimeInstallApprovalPanel" Visibility="Collapsed" Margin="0,4,0,10">
                    <TextBlock Text="Local CPU runtime archives only. Files are installed into a new portable folder; compatibility and execution still need verification." Foreground="#8CA6BC" TextWrapping="Wrap"/>
                    <Button x:Name="RuntimeInstallTermsButton" Content="Read bundled license terms" Click="RuntimeInstallTermsButton_Click" IsEnabled="False" HorizontalAlignment="Left" Padding="10,6" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RuntimeInstallLicenseCheck" Foreground="#E6EEF8" Margin="0,6,0,0" Checked="RuntimeInstallationApprovalChanged" Unchecked="RuntimeInstallationApprovalChanged"><TextBlock Text="I accept the declared runtime license shown in this review." TextWrapping="Wrap"/></CheckBox>
                    <CheckBox x:Name="RuntimeInstallBundledCheck" Foreground="#E6EEF8" Margin="0,6,0,0" Checked="RuntimeInstallationApprovalChanged" Unchecked="RuntimeInstallationApprovalChanged"><TextBlock Text="I have reviewed and accept the bundled dependency terms; the runtime license may not cover them." TextWrapping="Wrap"/></CheckBox>
                    <CheckBox x:Name="RuntimeInstallWritesCheck" Foreground="#E6EEF8" Margin="0,6,0,0" Checked="RuntimeInstallationApprovalChanged" Unchecked="RuntimeInstallationApprovalChanged"><TextBlock Text="I approve extracting these exact reviewed files into the new folder shown." TextWrapping="Wrap"/></CheckBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RuntimeInstallButton" Content="Install reviewed files" Click="RuntimeInstallButton_Click" IsEnabled="False" Padding="12,8"/>
                        <Button x:Name="RuntimeUseInstalledButton" Content="Use installed runtime" Click="RuntimeUseInstalledButton_Click" IsEnabled="False" Padding="12,8" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
</StackPanel></Expander>
            <Expander x:Name="ModelDownloadExpander" Header="Model download" IsExpanded="True" Foreground="#E6EEF8"><StackPanel>                <StackPanel Margin="0,10,0,0">
                                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DiscoveryDestinationText" Padding="8" ToolTip="Model destination folder on the assessed volume" TextChanged="DiscoveryDestinationText_TextChanged"/>
                    <Button Grid.Column="1" Content="Choose folder" Click="DiscoveryChooseFolderButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" x:Name="DiscoveryPlanButton" Content="Review download plan" Click="DiscoveryPlanButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" x:Name="DiscoveryVerifyButton" Content="Verify existing file" Click="DiscoveryVerifyButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                </Grid>
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <CheckBox x:Name="AcquisitionApprovalCheck" IsEnabled="False" Foreground="#E6F7FF" Checked="AcquisitionApprovalChanged" Unchecked="AcquisitionApprovalChanged">
                            <TextBlock Text="I approve this exact model-data plan and destination, and accept its source license terms." TextWrapping="Wrap"/>
                        </CheckBox>
                        <ProgressBar x:Name="AcquisitionProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,6,0,0" Value="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="AcquisitionDownloadButton" Content="Download approved model" Click="AcquisitionDownloadButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" x:Name="AcquisitionLibraryButton" Content="Add to library" Click="AcquisitionLibraryButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                </Grid>
</StackPanel></Expander>
            <TextBox x:Name="DownloadsDetailsText" Text="{Binding Text, ElementName=DiscoveryDetailsText, Mode=OneWay}" Height="300" Margin="0,16,0,12" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{Binding Text, ElementName=DiscoveryStatusText}" Foreground="#AABFD4" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer></TabItem>

        <TabItem x:Name="DiscoveryTab" Header="Discover AI" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Discover AI" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Find tools and models for your computer. Review the requirements before you install." Foreground="#8CA6BC" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="DiscoveryScanButton" Content="Scan this pc" DockPanel.Dock="Right" Click="DiscoveryScanButton_Click" Padding="14,8" Margin="12,0,0,0"/>
                    <TextBlock x:Name="DiscoveryHardwareText" Text="Scan this PC to use actual hardware, driver evidence, and available storage." TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="What would you like to create?" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveryInterestSelector" DisplayMemberPath="Name" SelectionChanged="DiscoveryInterestSelector_SelectionChanged" Padding="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Search models or publishers" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <TextBox x:Name="DiscoveryQueryText" Padding="8" MaxLength="160" ToolTip="Model or publisher terms, for example Qwen2.5 GGUF"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Install location" Foreground="#8CA6BC" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveryVolumeSelector" DisplayMemberPath="Path" SelectionChanged="DiscoveryVolumeSelector_SelectionChanged" Padding="8"/>
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="3" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="DiscoverySearchButton" Content="Search online" Click="DiscoverySearchButton_Click" Padding="12,8"/>
                        <Button x:Name="DiscoverySavedButton" Content="Load saved search" Click="DiscoverySavedButton_Click" Padding="12,8" Margin="8,0,0,0"/>
                        <Button x:Name="DiscoveryCancelButton" Content="Cancel" Click="DiscoveryCancelButton_Click" Padding="12,8" Margin="8,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="DiscoveryScopeText" TextWrapping="Wrap" Foreground="#8CA6BC" VerticalAlignment="Center"/>
                </DockPanel>
