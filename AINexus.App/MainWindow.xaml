                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PHYSICAL MEMORY IN USE" Style="{StaticResource MetricLabelStyle}"/>
                            <TextBlock x:Name="MemoryUsageText" Text="Sampling..." Style="{StaticResource MetricValueStyle}"/>
                            <TextBlock x:Name="MemoryAvailableText" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border Style="{StaticResource PanelStyle}" Margin="0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="NVIDIA GPU UTILIZATION / VRAM" FontSize="{DynamicResource NexusFontSize16}" Foreground="{DynamicResource NexusAccentBrush}" Margin="0,0,0,16"/>
