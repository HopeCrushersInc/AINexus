                    <TextBox x:Name="OllamaEndpointText" Text="http://127.0.0.1:11434" Padding="10" ToolTip="Loopback HTTP or HTTPS endpoint only"/>
                </DockPanel>
                <TextBlock Grid.Row="2" x:Name="OllamaStatusText" Text="No server queried yet. The portal does not start Ollama." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <TabControl Grid.Row="3" Background="{DynamicResource NexusBackgroundBrush}" Foreground="{DynamicResource NexusTextBrush}" BorderBrush="{DynamicResource NexusBorderBrush}">
                    <TabItem Header="Available models" Padding="12,8">
                        <DataGrid x:Name="OllamaAvailableGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Disk size" Binding="{Binding SizeDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Parameters" Binding="{Binding ParameterDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Quantization" Binding="{Binding QuantizationDisplay}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Loaded models" Padding="12,8">
                        <DataGrid x:Name="OllamaRunningGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <DataGridTextColumn Header="Loaded size" Binding="{Binding SizeDisplay}" Width="*"/>
                                <DataGridTextColumn Header="VRAM used" Binding="{Binding VramDisplay}" Width="*"/>
                                <DataGridTextColumn Header="Expires" Binding="{Binding ExpiresDisplay}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
                <TextBlock Grid.Row="4" x:Name="OllamaNoticeText" Text="Read-only queries to /api/tags and /api/ps. No model downloads, inference, or load/unload operations." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="EmbeddedTab" Header="Embedded Apps" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="LOCAL APPLICATION INTERFACE" FontSize="{DynamicResource NexusFontSize24}" FontWeight="Bold" Margin="0,0,0,16"/>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="EmbeddedOpenButton" DockPanel.Dock="Right" Content="Open in portal" Click="EmbeddedOpenButton_Click" Padding="18,10" Margin="12,0,0,0"/>
                    <TextBox x:Name="EmbeddedEndpointText" Padding="10" ToolTip="Enter the loopback URL of an existing local AI web interface"/>
                </DockPanel>
                <local:EmbeddedAppHost Grid.Row="2" x:Name="EmbeddedHost"/>
                <TextBlock Grid.Row="3" x:Name="EmbeddedStatusText" Text="Enter the address of an existing local web interface. The portal does not start a server. Downloads and new windows are blocked." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="AssistantTab" Header="Assistant" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="AgentRefreshModelsButton" DockPanel.Dock="Right" Content="Refresh local models" Click="AgentRefreshModelsButton_Click" Padding="12,8"/>
                    <TextBlock Text="LOCAL AGENT TASKS" FontSize="{DynamicResource NexusFontSize24}" FontWeight="Bold"/>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="AgentRuntimeSelector" Padding="8" Margin="0,0,12,0" DisplayMemberPath="Name" SelectionChanged="AgentRuntimeSelector_SelectionChanged" ToolTip="Runtime retained by each queued task"/>
                    <TextBox x:Name="AgentNameText" Grid.Column="1" Text="Local task" Padding="8" Margin="0,0,12,0" ToolTip="Task name" MaxLength="120"/>
                    <ComboBox x:Name="AgentModelSelector" Grid.Column="2" Padding="8" SelectionChanged="AgentModelSelector_SelectionChanged" ToolTip="Select an actual model ID reported by the selected local runtime"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="SYSTEM INSTRUCTION" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AgentSystemText" Text="Complete the user's task using the information provided." AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" MaxLength="8192"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TASK PROMPT" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AgentPromptText" AcceptsReturn="True" TextWrapping="Wrap" Height="65" VerticalScrollBarVisibility="Auto" MaxLength="32768"/>
                    </StackPanel>
                </Grid>
                <DockPanel Grid.Row="3" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="AgentEnqueueButton" Content="Queue task" Click="AgentEnqueueButton_Click" Padding="12,8" IsEnabled="False"/>
                        <Button Content="Cancel selected" Click="AgentCancelButton_Click" Padding="12,8" Margin="8,0,0,0"/>
                    </StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Min free RAM GiB" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="AgentMinRamText" Text="1" Width="48" Padding="5" MaxLength="12"/>
                        <TextBlock Text="Max CPU %" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="AgentMaxCpuText" Text="95" Width="48" Padding="5" MaxLength="12"/>
                        <TextBlock Text="Min free VRAM GiB (0=off)" VerticalAlignment="Center" Margin="12,0,6,0"/>
                        <TextBox x:Name="AgentMinVramText" Text="0" Width="48" Padding="5" MaxLength="12"/>
                    </WrapPanel>
                </DockPanel>
                <DataGrid Grid.Row="4" x:Name="AgentJobGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="AgentJobGrid_SelectionChanged" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" HeadersVisibility="Column" Margin="0,0,0,10">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Task" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Runtime" Binding="{Binding Runtime}" Width="Auto"/>
                        <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*"/>
                        <DataGridTextColumn Header="State" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBox Grid.Row="5" x:Name="AgentOutputText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" Padding="10"/>
                <TextBlock Grid.Row="6" x:Name="AgentStatusText" Text="Refresh local models, choose a model, and enter a prompt. Serial requests use resource admission checks, not OS quotas. Prompts and replies stay in this session. No model output is executed as code or tools." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="OfflineVerificationTab" Header="Verify Offline" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="VERIFY A LOCAL MODEL" FontSize="{DynamicResource NexusFontSize24}" FontWeight="Bold"/>
                    <TextBlock Text="Audit the saved artifact first, then explicitly test a selected local runtime. A checksum match alone does not prove inference works." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="OfflineReceiptBrowseButton" DockPanel.Dock="Right" Content="Choose receipt" Click="OfflineReceiptBrowseButton_Click" Padding="12,8" Margin="10,0,0,0"/>
                    <TextBox x:Name="OfflineReceiptText" Padding="8" ToolTip="Acquisition receipt under the model folder's .ainexus/receipts" TextChanged="OfflineInputChanged"/>
                </DockPanel>
                <DockPanel Grid.Row="2" Margin="0,0,0,12">
                    <Button x:Name="OfflineRuntimeBrowseButton" DockPanel.Dock="Right" Content="Choose runtime" Click="OfflineRuntimeBrowseButton_Click" Padding="12,8" Margin="10,0,0,0"/>
                    <TextBox x:Name="OfflineRuntimeText" Padding="8" ToolTip="Existing local llama-server.exe; no installer will be launched" TextChanged="OfflineInputChanged"/>
                </DockPanel>
                <WrapPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Context tokens" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="OfflineContextText" Text="4096" Width="70" Padding="7" MaxLength="8" TextChanged="OfflineInputChanged"/>
                    <Button x:Name="OfflineAuditButton" Content="Audit file integrity" Click="OfflineAuditButton_Click" IsEnabled="False" Padding="12,8" Margin="12,0,0,0"/>
                    <Button x:Name="OfflineRunButton" Content="RUN LOCAL SMOKE TEST (LOADS MODEL)" Click="OfflineRunButton_Click" IsEnabled="False" Padding="12,8" Margin="12,0,0,0"/>
                    <Button x:Name="OfflineCancelButton" Content="Cancel" Click="OfflineCancelButton_Click" Padding="12,8" Margin="12,0,0,0" IsEnabled="False"/>
                </WrapPanel>
                <TextBox Grid.Row="4" x:Name="OfflineEvidenceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" Padding="12" Text="An approved acquisition supplies a receipt automatically. You can also choose a saved receipt. Auditing reads local files only; running the smoke test temporarily loads the model and stops its own server afterward."/>
                <TextBlock Grid.Row="5" x:Name="OfflineStatusText" Text="No verification has run. No model or runtime is required to use online discovery." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="ImageStudioTab" Header="Image studio">
            <Grid>
            <StackPanel x:Name="ImageToolLanding" Margin="28"><TextBlock Text="Choose your image tool" FontSize="{DynamicResource NexusFontSize28}"/><TextBlock Text="Nexus includes no image engines. Search online and choose the tool you want to use." TextWrapping="Wrap" Margin="0,12,0,18"/><Button Content="Find image tools" Click="ImageFindTools_Click" HorizontalAlignment="Left"/></StackPanel>
            <Grid x:Name="ImageAdapterPanel" Visibility="Collapsed" Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,18"><TextBlock Text="From an idea to an image" FontSize="{DynamicResource NexusFontSize28}" FontWeight="SemiBold"/><TextBlock Text="Create with a local diffusion checkpoint. Your prompt stays on this computer." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
                <Expander Grid.Row="1" Header="Image engine" IsExpanded="True" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,18"><StackPanel>
                    <Button x:Name="ImageConnectFolderButton" Content="Connect model folder" Click="ComfyFolderOpenButton_Click" HorizontalAlignment="Left" Margin="0,8,0,8" ToolTip="Open a separate explicit review for existing engine and checkpoint folders; no engine is started"/>
                    <DockPanel Margin="0,10,0,8"><Button x:Name="ImageConnectButton" DockPanel.Dock="Right" Content="Check connection" Click="ImageConnectButton_Click" Margin="8,0,0,0"/><TextBox x:Name="ImageEndpointText" TextChanged="ImageInputsChanged" ToolTip="Only a local loopback image engine is supported"/></DockPanel>
                    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ImageStartButton" Content="Start engine" Click="ImageStartButton_Click" Margin="8,0,0,0"/><Button x:Name="ImageStopButton" Content="Stop engine" Click="ImageStopButton_Click" IsEnabled="False" Margin="8,0,0,0"/></StackPanel><TextBox x:Name="ImageEnginePathText" ToolTip="Existing ComfyUI portable folder. Start engine lets you choose it. No software is installed automatically."/></DockPanel>
                </StackPanel></Expander>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="Checkpoint" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="ImageModelSelector" SelectionChanged="ImageModelChanged" IsEnabled="False"/>
                        <TextBlock Text="What would you like to create?" FontWeight="SemiBold" Margin="0,20,0,8"/>
                        <TextBox x:Name="ImagePromptText" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="4000"/>
                        <Expander Header="Things to avoid (optional)" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,16,0,16"><TextBox x:Name="ImageNegativeText" Height="75" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000" Margin="0,8,0,0"/></Expander>
                        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Width (px)" Margin="0,0,0,6"/><TextBox x:Name="ImageWidthText" Text="512" MaxLength="4" TextChanged="ImageDimensionsChanged" ToolTip="256–1024 pixels, in multiples of 64"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Height (px)" Margin="0,0,0,6"/><TextBox x:Name="ImageHeightText" Text="512" MaxLength="4" TextChanged="ImageDimensionsChanged" ToolTip="256–1024 pixels, in multiples of 64"/></StackPanel>
                        </Grid>
                        <TextBlock x:Name="ImageDimensionHintText" Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" FontSize="{DynamicResource NexusFontSize12}" Margin="0,0,0,8"/>
                        <TextBlock Text="Standard diffusion workflow · 20 steps. A checkpoint's actual support is established by running it, not its filename. Image size is session-only." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" FontSize="{DynamicResource NexusFontSize12}" Margin="0,0,0,16"/>
                        <Button x:Name="ImageGenerateButton" Content="Generate image" Background="{DynamicResource NexusButtonBrush}" Click="ImageGenerateButton_Click" IsEnabled="False"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button x:Name="ImageCancelButton" Content="Cancel image" Click="ImageCancelButton_Click" IsEnabled="False"/><Button x:Name="ImageSaveButton" Content="Save PNG" Click="ImageSaveButton_Click" IsEnabled="False" Margin="8,0,0,0"/></StackPanel>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Column="2" Background="{DynamicResource NexusPanelBrush}" CornerRadius="10" Padding="20"><Grid>
                        <TextBlock Text="Your image will appear here" Foreground="{DynamicResource NexusMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=ImagePreview}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <Image x:Name="ImagePreview" Stretch="Uniform"/>
                    </Grid></Border>
                </Grid>
                <TextBlock Grid.Row="3" x:Name="ImageStatusText" Text="No image engine has been checked. Connect an installed ComfyUI engine to discover its actual checkpoints. Nothing loads until you ask." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </Grid></Grid>
        </TabItem>
        <TabItem x:Name="ToolDetailsTab" Header="Selected tool"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock x:Name="SelectedToolTitleText" Text="No tool selected" FontSize="{DynamicResource NexusFontSize28}"/>
            <TextBox x:Name="SelectedToolDetailsText" IsReadOnly="True" TextWrapping="Wrap" Margin="0,14,0,18"/>
            <WrapPanel><Button Content="Open selected source" Click="SelectedToolSource_Click"/><Button x:Name="SelectedToolUseExistingButton" Content="Use an existing installation" Click="SelectedToolUseExisting_Click" Visibility="Collapsed" Margin="12,0,0,0"/><Button x:Name="SelectedToolArchiveButton" Content="Review archive download" Click="SelectedToolArchive_Click" Visibility="Collapsed" Margin="12,0,0,0"/></WrapPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="ComfyPortableSetupTab" Header="Get image engine archive"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock Text="Get a portable image engine" FontSize="{DynamicResource NexusFontSize28}" FontWeight="SemiBold"/>
            <TextBlock Text="Choose an official ComfyUI archive, review it, then approve its download. This step does not extract, install or start an engine." TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,10,0,20"/>
            <Border Style="{StaticResource PanelStyle}"><StackPanel>
                <TextBlock Text="1. Check the official release" FontSize="{DynamicResource NexusFontSize20}"/>
                <TextBlock Text="Optional release tag (leave blank to check the current release)" Margin="0,12,0,5"/>
                <TextBox x:Name="ComfyPortableTagText" TextChanged="ComfyPortableInputChanged"/>
                <Button x:Name="ComfyPortableLookupButton" Content="Check releases" Click="ComfyPortableLookup_Click" HorizontalAlignment="Left" Margin="0,10,0,12"/>
                <TextBlock Text="2. Choose an archive yourself"/>
                <ComboBox x:Name="ComfyPortableAssetSelector" DisplayMemberPath="Name" SelectionChanged="ComfyPortableAssetChanged" Margin="0,6,0,12"/>
                <TextBlock Text="Archive names describe publisher builds; they do not prove compatibility with your GPU or driver." TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}"/>
                <TextBlock Text="3. Choose an existing download folder" Margin="0,16,0,6"/>
                <DockPanel><Button x:Name="ComfyPortableBrowseButton" DockPanel.Dock="Right" Content="Choose folder" Click="ComfyPortableBrowse_Click" Margin="10,0,0,0"/><TextBox x:Name="ComfyPortableDestinationText" TextChanged="ComfyPortableInputChanged"/></DockPanel>
                <Button x:Name="ComfyPortableReviewButton" Content="Review archive download" Click="ComfyPortableReview_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel></Border>
            <Border Style="{StaticResource PanelStyle}"><StackPanel>
                <TextBox x:Name="ComfyPortableDetailsText" Text="No release, archive or destination selected." TextWrapping="Wrap" IsReadOnly="True" MaxHeight="240" VerticalScrollBarVisibility="Auto"/>
                <Button x:Name="ComfyPortableTermsButton" Content="Read source terms" Click="ComfyPortableTerms_Click" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                <CheckBox x:Name="ComfyPortableApprovalCheck" Foreground="{DynamicResource NexusTextBrush}" Margin="0,16,0,10" Checked="ComfyPortableApprovalChanged" Unchecked="ComfyPortableApprovalChanged"><TextBlock Text="I accept the displayed ComfyUI source terms and approve this exact archive download and destination. Bundled components need separate terms review before installation. This download does not install an engine." TextWrapping="Wrap"/></CheckBox>
                <WrapPanel><Button x:Name="ComfyPortableDownloadButton" Content="Download approved archive" Click="ComfyPortableDownload_Click"/><Button x:Name="ComfyPortableInspectButton" Content="Inspect existing archive" Click="ComfyPortableInspect_Click" Margin="12,0,0,0" ToolTip="Recheck exact size/hash and read archive metadata only; no extraction or execution"/><Button x:Name="ComfyPortableCancelButton" Content="Cancel" Click="ComfyPortableCancel_Click" Margin="12,0,0,0"/></WrapPanel>
                <ProgressBar x:Name="ComfyPortableProgress" Height="5" Minimum="0" Maximum="100" Margin="0,14,0,0"/>
            </StackPanel></Border>
            <TextBlock x:Name="ComfyPortableStatusText" Text="Nothing has been checked or downloaded." TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}"/>
        </StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Window>
