                    <Button Content="{Binding Name}" IsEnabled="{Binding Available}" Click="WorkloadCardAction_Click" ToolTip="{Binding Description}" Margin="0,0,0,8"/>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
        </Grid></ScrollViewer></TabItem>
        <TabItem x:Name="DownloadsTab" Header="Downloads &amp; setup"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock Text="Review before installing" FontSize="{DynamicResource NexusFontSize28}" FontWeight="SemiBold"/><TextBlock Text="Choose an item in Discover, then review its files, destination and requirements here." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16"/>
            <TextBlock Text="{Binding Text, ElementName=StoreSelectionTitleText}" FontSize="{DynamicResource NexusFontSize20}" Margin="0,0,0,12"/>
            <Expander x:Name="RuntimePackagesExpander" Header="Runtime packages (advanced)" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,16"><StackPanel Margin="0,10,0,0"><DockPanel Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="RuntimeReleaseLookupButton" Content="Look up release" Click="RuntimeReleaseLookupButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                        <Button x:Name="RuntimeReleaseSavedButton" Content="Load saved release" Click="RuntimeReleaseSavedButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Left" Text="EXPLICIT RELEASE TAG" VerticalAlignment="Center" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,8,0"/>
                    <TextBox x:Name="RuntimeReleaseTagText" Padding="8" MaxLength="128" ToolTip="Enter an exact upstream llama.cpp release tag. No latest or nightly fallback is selected."/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="NEW RUNTIME FOLDER" VerticalAlignment="Center" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,8,0"/>
                    <Button x:Name="RuntimeSetupReviewButton" DockPanel.Dock="Right" Content="Review runtime setup" Click="RuntimeSetupReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <TextBox x:Name="RuntimeDestinationText" Padding="8" TextChanged="RuntimeDestinationText_TextChanged" ToolTip="New runtime folder on the assessed volume; existing folders cannot be used"/>
                </DockPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Left" Text="RUNTIME ARCHIVE" VerticalAlignment="Center" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,8,0"/>
                    <ComboBox x:Name="RuntimeArchiveSelector" DisplayMemberPath="Name" SelectionChanged="RuntimeArchiveSelector_SelectionChanged" IsEnabled="False" Padding="8" ToolTip="Explicitly select a published runtime archive; no archive is chosen automatically"/>
                </DockPanel>
                <WrapPanel Margin="0,0,0,8">
                    <Button x:Name="RuntimeFileReviewButton" Content="Review selected files" Click="RuntimeFileReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                    <Button x:Name="RuntimeInspectButton" Content="Inspect local zip files" Click="RuntimeInspectButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                    <Button x:Name="RuntimeInstallReviewButton" Content="Review local install" Click="RuntimeInstallReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                </WrapPanel>
                <Expander x:Name="RuntimeDownloadExpander" Header="Runtime archive download" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,4,0,12"><StackPanel Margin="0,6,0,0">
                    <TextBlock Text="Single CPU runtime ZIP; installation approval is separate." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap"/>
                    <DockPanel Margin="0,6,0,6">
                        <Button x:Name="RuntimeDownloadBrowseButton" DockPanel.Dock="Right" Content="Choose download folder" Click="RuntimeDownloadBrowseButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                        <TextBox x:Name="RuntimeDownloadDirectoryText" Padding="8" TextChanged="RuntimeDownloadDirectoryChanged" ToolTip="Existing local folder for the exact reviewed ZIP; separate from the new installation folder"/>
                    </DockPanel>
                    <WrapPanel>
                        <Button x:Name="RuntimeDownloadReviewButton" Content="Review runtime download" Click="RuntimeDownloadReviewButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeDownloadButton" Content="Download approved archive" Click="RuntimeDownloadButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeDownloadCancelButton" Content="Cancel download" Click="RuntimeDownloadCancelButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                        <Button x:Name="RuntimeDownloadedInspectButton" Content="Inspect downloaded archive" Click="RuntimeDownloadedInspectButton_Click" IsEnabled="False" Padding="10,8" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <CheckBox x:Name="RuntimeDownloadApprovalCheck" Foreground="{DynamicResource NexusTextBrush}" IsEnabled="False" Checked="RuntimeDownloadApprovalChanged" Unchecked="RuntimeDownloadApprovalChanged">
                        <TextBlock Text="I approve this exact runtime ZIP and download folder, accept its declared runtime license, and understand bundled terms need separate review before installation." TextWrapping="Wrap"/>
                    </CheckBox>
                    <ProgressBar x:Name="RuntimeDownloadProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,8,0,0"/>
                </StackPanel></Expander>
                <StackPanel x:Name="RuntimeInstallApprovalPanel" Visibility="Collapsed" Margin="0,4,0,10">
                    <TextBlock Text="Local CPU runtime archives only. Files are installed into a new portable folder; compatibility and execution still need verification." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap"/>
                    <Button x:Name="RuntimeInstallTermsButton" Content="Read bundled license terms" Click="RuntimeInstallTermsButton_Click" IsEnabled="False" HorizontalAlignment="Left" Padding="10,6" Margin="0,6,0,0"/>
                    <CheckBox x:Name="RuntimeInstallLicenseCheck" Foreground="{DynamicResource NexusTextBrush}" Margin="0,6,0,0" Checked="RuntimeInstallationApprovalChanged" Unchecked="RuntimeInstallationApprovalChanged"><TextBlock Text="I accept the declared runtime license shown in this review." TextWrapping="Wrap"/></CheckBox>
                    <CheckBox x:Name="RuntimeInstallBundledCheck" Foreground="{DynamicResource NexusTextBrush}" Margin="0,6,0,0" Checked="RuntimeInstallationApprovalChanged" Unchecked="RuntimeInstallationApprovalChanged"><TextBlock Text="I have reviewed and accept the bundled dependency terms; the runtime license may not cover them." TextWrapping="Wrap"/></CheckBox>
                    <CheckBox x:Name="RuntimeInstallWritesCheck" Foreground="{DynamicResource NexusTextBrush}" Margin="0,6,0,0" Checked="RuntimeInstallationApprovalChanged" Unchecked="RuntimeInstallationApprovalChanged"><TextBlock Text="I approve extracting these exact reviewed files into the new folder shown." TextWrapping="Wrap"/></CheckBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="RuntimeInstallButton" Content="Install reviewed files" Click="RuntimeInstallButton_Click" IsEnabled="False" Padding="12,8"/>
                        <Button x:Name="RuntimeUseInstalledButton" Content="Use installed runtime" Click="RuntimeUseInstalledButton_Click" IsEnabled="False" Padding="12,8" Margin="8,0,0,0"/>
                    </WrapPanel>
                </StackPanel>
</StackPanel></Expander>
            <Expander x:Name="ModelDownloadExpander" Header="Model download" IsExpanded="True" Foreground="{DynamicResource NexusTextBrush}"><StackPanel>                <StackPanel Margin="0,10,0,0">
                                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DiscoveryDestinationText" Padding="8" ToolTip="Model destination folder on the assessed volume" TextChanged="DiscoveryDestinationText_TextChanged"/>
                    <Button Grid.Column="1" Content="Choose folder" Click="DiscoveryChooseFolderButton_Click" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" x:Name="DiscoveryPlanButton" Content="Review download plan" Click="DiscoveryPlanButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="3" x:Name="DiscoveryVerifyButton" Content="Verify existing file" Click="DiscoveryVerifyButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                </Grid>
                </StackPanel>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <CheckBox x:Name="AcquisitionApprovalCheck" IsEnabled="False" Foreground="{DynamicResource NexusTextBrush}" Checked="AcquisitionApprovalChanged" Unchecked="AcquisitionApprovalChanged">
                            <TextBlock Text="I approve this exact model-data plan and destination, and accept its source license terms." TextWrapping="Wrap"/>
                        </CheckBox>
                        <ProgressBar x:Name="AcquisitionProgressBar" Minimum="0" Maximum="100" Height="5" Margin="0,6,0,0" Value="0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="AcquisitionDownloadButton" Content="Download approved model" Click="AcquisitionDownloadButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                    <Button Grid.Column="2" x:Name="AcquisitionLibraryButton" Content="Add to library" Click="AcquisitionLibraryButton_Click" IsEnabled="False" Padding="10,8" Margin="8,0,0,0"/>
                </Grid>
</StackPanel></Expander>
            <TextBox x:Name="DownloadsDetailsText" Text="{Binding Text, ElementName=DiscoveryDetailsText, Mode=OneWay}" Height="300" Margin="0,16,0,12" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
            <TextBlock Text="{Binding Text, ElementName=DiscoveryStatusText}" Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer></TabItem>

        <TabItem x:Name="DiscoveryTab" Header="Discover AI" Padding="18,10">
            <Grid Margin="18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,14">
                    <TextBlock Text="Discover AI" FontSize="{DynamicResource NexusFontSize24}" FontWeight="Bold"/>
                    <TextBlock Text="Find tools and models for your computer. Review the requirements before you install." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <Button x:Name="DiscoveryScanButton" Content="Scan this pc" DockPanel.Dock="Right" Click="DiscoveryScanButton_Click" Padding="14,8" Margin="12,0,0,0"/>
                    <TextBlock x:Name="DiscoveryHardwareText" Text="Scan this PC to use actual hardware, driver evidence, and available storage." TextWrapping="Wrap" VerticalAlignment="Center"/>
                </DockPanel>
                <Grid Grid.Row="2" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Optional category filter (blank searches all chosen tasks)" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveryInterestSelector" DisplayMemberPath="Name" SelectionChanged="DiscoveryInterestSelector_SelectionChanged" Padding="8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Search models or publishers" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="DiscoveryQueryText" Padding="8" MaxLength="160" ToolTip="Optional model, tool or publisher terms. Leave blank to search the selected categories."/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Install location" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="DiscoveryVolumeSelector" DisplayMemberPath="Path" SelectionChanged="DiscoveryVolumeSelector_SelectionChanged" Padding="8"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="3" Margin="0,0,0,12"><DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                        <Button x:Name="DiscoverySearchButton" Content="Search online" Click="DiscoverySearchButton_Click" Padding="12,8"/>
                        <Button x:Name="DiscoverySearchAllButton" Content="Search all chosen tasks" Click="DiscoverySearchAllButton_Click" Padding="12,8" Margin="8,0,0,0" Visibility="Collapsed"/>
                        <Button x:Name="DiscoverySavedButton" Content="Load saved search" Click="DiscoverySavedButton_Click" Padding="12,8" Margin="8,0,0,0"/>
                        <Button x:Name="DiscoveryCancelButton" Content="Cancel" Click="DiscoveryCancelButton_Click" Padding="12,8" Margin="8,0,0,0" IsEnabled="False"/>
                    </StackPanel>
                    <TextBlock x:Name="DiscoveryScopeText" TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                    <DockPanel Margin="0,8,0,0">
                        <ComboBox x:Name="DiscoveryOrderSelector" DockPanel.Dock="Left" Width="230" DisplayMemberPath="Name" SelectionChanged="DiscoveryOrderSelector_SelectionChanged" Padding="6" ToolTip="Optional text-model search order. Blank combines popular, trending and recently updated sources. No model is chosen."/>
                        <TextBlock Text="Text search: blank mixes popular, trending and recent. Source activity is not a quality score." TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </DockPanel>
                    <TextBlock x:Name="DiscoveryFitSummaryText" TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,8,0,4"/>
                    <TextBlock x:Name="DiscoveryImageCandidatesNoticeText" Text="Image file candidates — hardware fit and complete checkpoint contents are unverified." Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource NexusSecondaryBrush}" Margin="0,0,0,8"/>
                    <DockPanel>
                        <Button x:Name="DiscoveryEvidenceButton" DockPanel.Dock="Right" Content="Benchmark evidence" Click="DiscoveryEvidenceButton_Click" IsEnabled="False" Padding="12,6" Margin="8,0,0,0"/>
                        <Button x:Name="DiscoveryBrowseVariantsButton" DockPanel.Dock="Right" Content="Browse selected model's files" Click="DiscoveryBrowseVariantsButton_Click" IsEnabled="False" Padding="12,6"/>
                        <CheckBox x:Name="DiscoveryShowUnassessedCheck" Content="Show only estimated-fit results" IsChecked="False" Checked="DiscoveryShowUnassessedCheck_Changed" Unchecked="DiscoveryShowUnassessedCheck_Changed" Foreground="{DynamicResource NexusMutedBrush}" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
                <DataGrid Grid.Row="4" x:Name="DiscoveryResultsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="DiscoveryResultsGrid_SelectionChanged" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" HeadersVisibility="Column" EnableRowVirtualization="True" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" MinWidth="260"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Workload}" Width="1.4*"/>
                        <DataGridTextColumn Header="Available action" Binding="{Binding ActionDisplay}" Width="Auto"/>

                        <DataGridTextColumn Header="Download size" Binding="{Binding SizeDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Repository updated" Binding="{Binding UpdatedDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Repository parameters" Binding="{Binding ParametersDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="HF downloads" Binding="{Binding DownloadsDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Selected drive" Binding="{Binding StorageDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="Runtime memory estimate" Binding="{Binding MemoryDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="License" Binding="{Binding LicenseDisplay}" Width="*"/>
                        <DataGridTextColumn Header="Hardware estimate" Binding="{Binding StatusDisplay}" Width="1.2*"/>

                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Row="5" Margin="0,8,0,0">
                    <DockPanel><Button DockPanel.Dock="Right" Content="Review selected item" Click="DiscoveryReviewSelected_Click" Margin="16,0,0,0"/><Button x:Name="DiscoveryOpenSourceButton" DockPanel.Dock="Right" Content="Open source page" Click="DiscoveryOpenSourceButton_Click" IsEnabled="False" Margin="8,0,0,0"/><StackPanel><TextBlock x:Name="StoreSelectionTitleText" Text="Choose a result" FontSize="{DynamicResource NexusFontSize20}" FontWeight="SemiBold"/><TextBlock x:Name="StoreSelectionSummaryText" Text="Select an item to see what is known about compatibility." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,10"/></StackPanel></DockPanel>
                    <Expander x:Name="DiscoveryDetailsExpander" Header="Compatibility and source details" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,8,0,0"><TextBox x:Name="DiscoveryDetailsText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" Padding="12" Height="220" Text="Select a result to review its source evidence, requirement estimate, assumptions, and unknowns. No software is installed by discovery."/></Expander>
                    <Expander x:Name="ModelEvidenceExpander" Header="Reported benchmark evidence" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Inspect a repository explicitly. Source-reported scores are not proof of this quantized file's quality; different benchmark tasks are not directly comparable." TextWrapping="Wrap" Margin="0,6"/>
                            <TextBlock Text="Repository (publisher/model)" Margin="0,0,0,4"/>
                            <DockPanel>
                                <Button x:Name="ModelEvidenceReadButton" DockPanel.Dock="Right" Content="Read public evaluations" Click="ModelEvidenceReadButton_Click" Margin="8,0,0,0"/>
                                <Button x:Name="ModelEvidenceSavedButton" DockPanel.Dock="Right" Content="Load saved evidence" Click="ModelEvidenceSavedButton_Click" Margin="8,0,0,0"/>
                                <Button x:Name="ModelEvidenceCancelButton" DockPanel.Dock="Right" Content="Cancel" Click="ModelEvidenceCancelButton_Click" IsEnabled="False" Margin="8,0,0,0"/>
                                <TextBox x:Name="ModelEvidenceRepositoryText" TextChanged="ModelEvidenceRepositoryText_TextChanged" MaxLength="193" Padding="8" ToolTip="Exact publisher/model repository. Blank on startup; no upstream repository is substituted."/>
                            </DockPanel>
                            <TextBox x:Name="ModelEvidenceDetailsText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Height="200" Padding="10" Margin="0,8,0,0" Background="{DynamicResource NexusPanelBrush}" Foreground="{DynamicResource NexusTextBrush}" Text="No benchmark source inspected. Quality remains unknown."/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <TextBlock Grid.Row="6" x:Name="DiscoveryStatusText" Text="Online search reads public metadata only. Hardware evaluation stays on this PC. Installation, builds, and remote-server access require separate approval." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </TabItem>
        <TabItem x:Name="HardwareTab" Header="This computer" Padding="18,10">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="AI NEXUS" FontSize="{DynamicResource NexusFontSize13}" Foreground="{DynamicResource NexusAccentBrush}" FontWeight="Bold"/>
                <TextBlock Text="SYSTEM OVERVIEW" FontSize="{DynamicResource NexusFontSize28}" FontWeight="Bold" Margin="0,5,0,0"/>
                <TextBlock Text="Live machine profile - local AI readiness" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="PHASE 01 / HARDWARE DISCOVERY" Foreground="{DynamicResource NexusAccentBrush}" HorizontalAlignment="Right"/>
                <TextBlock x:Name="ScanStatusText" Text="INITIALIZING SCAN..." Foreground="{DynamicResource NexusMutedBrush}" Margin="0,8,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,0,0,4">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="PROCESSOR" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="CpuText" Text="Scanning..." Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Detected via Windows CIM" Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize11}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource PanelStyle}">
                <StackPanel>
                    <TextBlock Text="SYSTEM MEMORY" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="RamText" Text="Scanning..." Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="Installed physical RAM" Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize11}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource PanelStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="GRAPHICS ADAPTERS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="GpuCountText" Text="Scanning..." Style="{StaticResource MetricValueStyle}"/>
                    <TextBlock Text="VRAM reported when available" Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize11}" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="2">
