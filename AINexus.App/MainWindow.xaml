<Window x:Class="AINexus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AINexus.App"
        Title="AI Nexus Portal" Height="900" Width="1440"
        MinHeight="650" MinWidth="950" Background="{DynamicResource NexusBackgroundBrush}" Foreground="{DynamicResource NexusTextBrush}"
        FontFamily="{DynamicResource NexusFontFamily}" FontSize="{DynamicResource NexusBaseFontSize}" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" WindowStyle="SingleBorderWindow" PreviewMouseWheel="Window_PreviewMouseWheel">
    <Window.Resources>
        <DataTemplate x:Key="FeaturedModelCard">
            <Border Background="{DynamicResource NexusPanelBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,12,12">
                <StackPanel>
                    <TextBlock Text="{Binding NsfwLabel}" Foreground="{DynamicResource NexusSecondaryBrush}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource NexusFontSize24}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,6,0,8"/>
                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" MinHeight="56"/>
                    <TextBlock Text="{Binding LicenseNote}" Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,14"/>
                    <Button Content="Install and chat" Tag="{Binding}" Click="FeaturedModelInstall_Click" HorizontalAlignment="Left" Background="{DynamicResource NexusButtonBrush}"/>
                </StackPanel>
            </Border>
        </DataTemplate>
        <SolidColorBrush x:Key="PanelBrush" Color="#182638"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#26394E"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#66C0F4"/>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource NexusPanelBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource NexusBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource NexusCornerRadius}"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
        </Style>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NexusMutedBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource NexusFontSize12}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource NexusAccentBrush}"/>
            <Setter Property="FontSize" Value="{DynamicResource NexusFontSize20}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource NexusMutedBrush}"/>
            <Setter Property="Background" Value="{DynamicResource NexusPanelBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}" Margin="0,0,6,0">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NexusAccentBrush}"/>
                                <Setter Property="Background" Value="{DynamicResource NexusSelectedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/>
            <Setter Property="Background" Value="{DynamicResource NexusButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="{DynamicResource NexusBorderBrush}"/><Setter Property="Padding" Value="{DynamicResource NexusButtonPadding}"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="{DynamicResource NexusButtonMinHeight}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{DynamicResource NexusCornerRadius}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource NexusHoverBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource NexusAccentBrush}"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/><Setter Property="Background" Value="{DynamicResource NexusBackgroundBrush}"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource NexusBorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource NexusTextBrush}"/><Setter Property="Padding" Value="10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/><Setter Property="Foreground" Value="#172536"/><Setter Property="Background" Value="#DCE7F2"/><Setter Property="MinHeight" Value="38"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="DataGrid"><Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/><Setter Property="RowBackground" Value="{DynamicResource NexusPanelBrush}"/><Setter Property="AlternatingRowBackground" Value="{DynamicResource NexusButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/><Setter Property="GridLinesVisibility" Value="None"/><Setter Property="RowHeight" Value="{DynamicResource NexusRowHeight}"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource NexusButtonBrush}"/><Setter Property="Foreground" Value="{DynamicResource NexusMutedBrush}"/><Setter Property="Padding" Value="12,10"/><Setter Property="BorderThickness" Value="0"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="10,6"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource NexusSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/></Trigger></Style.Triggers></Style>
        <Style x:Key="NavStyle" TargetType="RadioButton"><Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/><Setter Property="Foreground" Value="{DynamicResource NexusMutedBrush}"/><Setter Property="Margin" Value="0,2"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="NavSurface" Padding="{DynamicResource NexusNavPadding}" CornerRadius="{DynamicResource NexusCornerRadius}" Background="{DynamicResource NexusButtonBrush}" BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="1"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NexusSelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource NexusHoverBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="Menu"><Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/></Style>
        <Style TargetType="MenuItem"><Setter Property="FontSize" Value="{DynamicResource NexusBaseFontSize}"/><Setter Property="Foreground" Value="{DynamicResource NexusTextBrush}"/><Setter Property="Background" Value="{DynamicResource NexusPanelBrush}"/><Setter Property="Padding" Value="8,5"/></Style>
    </Window.Resources>
    <Grid x:Name="AppContentRoot">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="{DynamicResource NexusSidebarWidth}"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <local:NexusBackdrop x:Name="SpaceBackdrop" Grid.ColumnSpan="2"/>
        <Border Background="{DynamicResource NexusPanelBrush}" Padding="16,24"><DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Top" Margin="8,0,0,30"><TextBlock Text="AI NEXUS" FontSize="{DynamicResource NexusFontSize24}" FontWeight="Bold" Foreground="{DynamicResource NexusAccentBrush}"/><TextBlock Text="Your local AI workspace" Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize12}" Margin="0,5,0,0"/></StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="Local first. Yours to control." Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize11}" TextWrapping="Wrap" Margin="8,20,0,0"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="StoreNavigation" Visibility="Collapsed">
                <RadioButton x:Name="HomeNav" Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Home" Tag="StoreHomeTab" IsChecked="True" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Chat" Tag="ChatTab" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Discover" Tag="DiscoveryTab" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Library" Tag="CatalogLibraryTab" Click="StoreNavigate_Click"/>
                <TextBlock x:Name="CreateWorkspaceHeading" Text="CREATE" Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize11}" Margin="18,25,0,7"/>
                <RadioButton x:Name="ImageWorkspaceNav" Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Images" Visibility="Collapsed" Tag="ImageStudioTab" Click="StoreNavigate_Click"/>
                <RadioButton x:Name="AssistantWorkspaceNav" Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Assistant" Visibility="Collapsed" Tag="AssistantTab" Click="StoreNavigate_Click"/>
                <TextBlock Text="MANAGE" Foreground="{DynamicResource NexusMutedBrush}" FontSize="{DynamicResource NexusFontSize11}" Margin="18,25,0,7"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Downloads &amp; setup" Tag="DownloadsTab" Click="StoreNavigate_Click"/>
                <RadioButton Style="{StaticResource NavStyle}" GroupName="StoreNav" Content="Performance" Tag="ResourcesTab" Click="StoreNavigate_Click"/>
                <Expander Header="Advanced tools" Foreground="{DynamicResource NexusMutedBrush}" Margin="16,24,0,0"><StackPanel>
                    <Button Content="This computer" Tag="HardwareTab" Click="StoreNavigate_Click" Margin="0,8,0,4"/>
                    <Button Content="Installed tools" Tag="SoftwareTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Local model server" Tag="LlamaCppTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Ollama" Tag="OllamaTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Package manager" Tag="PackageTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Embedded apps" Tag="EmbeddedTab" Click="StoreNavigate_Click" Margin="0,0,0,4"/>
                    <Button Content="Offline checks" Tag="OfflineVerificationTab" Click="StoreNavigate_Click"/>
                </StackPanel></Expander>
            </StackPanel></ScrollViewer>
        </DockPanel></Border>
        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="72"/><RowDefinition/></Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource NexusBorderBrush}" BorderThickness="0,0,0,1" Padding="24,14"><DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UiScaleText" Text="100%" FontSize="{DynamicResource NexusFontSize12}" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip="Shift + mouse wheel changes text and button size"/>
                    <Menu Background="Transparent" Foreground="{DynamicResource NexusTextBrush}">
                        <MenuItem x:Name="AppearanceMenu" Header="_Appearance">
                            <MenuItem x:Name="AppearanceStandardMenuItem" Header="_Standard" IsCheckable="True" Click="AppearanceStandard_Click"/>
                            <MenuItem x:Name="AppearanceLcarsMenuItem" Header="_LCARS" IsCheckable="True" Click="AppearanceLcars_Click"/>
                            <MenuItem Header="Cyberpunk" Tag="Cyberpunk" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Midnight" Tag="Midnight" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Ocean" Tag="Ocean" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Forest" Tag="Forest" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Ember" Tag="Ember" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Graphite" Tag="Graphite" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Paper" Tag="Paper" IsCheckable="True" Click="AppearanceChoice_Click"/>
                            <MenuItem Header="Terminal" Tag="Terminal" IsCheckable="True" Click="AppearanceChoice_Click"/>
                        </MenuItem>
                        <MenuItem Header="_Size">
                            <MenuItem Header="Larger text and buttons" Click="UiScaleLarger_Click"/>
                            <MenuItem Header="Smaller text and buttons" Click="UiScaleSmaller_Click"/>
                            <Separator/>
                            <MenuItem Header="Reset to 100%" Click="UiScaleReset_Click"/>
                        </MenuItem>
                    </Menu>
                </StackPanel>
                <TextBlock x:Name="StorePageTitleText" Text="Home" FontSize="{DynamicResource NexusFontSize24}" FontWeight="SemiBold"/>
            </DockPanel></Border>
            <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Background="Transparent" Foreground="{DynamicResource NexusTextBrush}" BorderThickness="0" SelectionChanged="WorkspaceTabs_SelectionChanged">
                <TabControl.Template><ControlTemplate TargetType="TabControl"><Border Background="{TemplateBinding Background}"><Grid><TabPanel IsItemsHost="True" Height="0" ClipToBounds="True" VerticalAlignment="Top"/><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="0"/></Grid></Border></ControlTemplate></TabControl.Template>


        <TabItem x:Name="WorkloadSetupTab" Header="Set up your workspace"><Grid><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="32">
            <TextBlock Text="Choose your tasks" FontSize="{DynamicResource NexusFontSize30}" FontWeight="SemiBold"/>
            <TextBlock Text="Scan this computer → Choose your workloads → Review compatible tools → Approve downloads" Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,24"/>
            <Border Style="{StaticResource PanelStyle}"><StackPanel>
                <DockPanel><Button x:Name="WorkloadRescanButton" DockPanel.Dock="Right" Content="Rescan hardware" Click="WorkloadRescanButton_Click" IsEnabled="False" Margin="12,0,0,0"/><TextBlock Text="1. Your hardware" FontSize="{DynamicResource NexusFontSize22}" FontWeight="SemiBold"/></DockPanel>
                <ProgressBar x:Name="WorkloadScanProgress" IsIndeterminate="True" Height="4" Margin="0,16,0,12"/>
                <TextBlock x:Name="WorkloadHardwareText" Text="Waiting for the local hardware scan..." Foreground="{DynamicResource NexusTextBrush}" TextWrapping="Wrap" Margin="0,8,0,12"/>
                <TextBlock x:Name="WorkloadScanStatusText" Text="The hardware scan runs first. No downloads, installs or engines will start." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <StackPanel x:Name="WorkloadOptionsPanel" Visibility="Collapsed" Margin="0,16,0,0">
                <TextBlock Text="2. Choose what you want to do" FontSize="{DynamicResource NexusFontSize24}" FontWeight="SemiBold" Margin="0,6,0,8"/>
                <TextBlock Text="Choose one or more interests, then find online choices. Nexus searches every selected category and checks the results against this hardware scan. This does not approve any download." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                <ItemsControl x:Name="WorkloadChoices"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                    <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource NexusTextBrush}" VerticalContentAlignment="Center" Margin="0,5,20,5" Padding="8,4" ToolTip="{Binding Description}"><TextBlock Text="{Binding Name}" FontSize="{DynamicResource NexusFontSize17}" TextWrapping="Wrap"/></CheckBox>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <TextBlock Text="You will choose specific tools and models next. Nothing is installed or loaded until you explicitly ask." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
</StackPanel></ScrollViewer>
<Border Grid.Row="1" Padding="28,10" Background="{DynamicResource NexusPanelBrush}" Visibility="{Binding Visibility, ElementName=WorkloadOptionsPanel}"><DockPanel><Button x:Name="WorkloadContinueButton" DockPanel.Dock="Left" Content="Find online choices" Click="WorkloadContinueButton_Click" IsEnabled="False" Margin="0,0,18,0"/><TextBlock Text="Search your chosen tasks. Review and approve any download separately." VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource NexusMutedBrush}"/></DockPanel></Border>
</Grid></TabItem>
<TabItem x:Name="CatalogTab" Header="Legacy diagnostics" Visibility="Collapsed"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock Text="Install a local model" FontSize="{DynamicResource NexusFontSize30}" FontWeight="SemiBold"/>
            <TextBlock Text="Choose the model, review its exact download, then open chat. No subscriptions." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <CheckBox x:Name="FeaturedNsfwCheck" Content="Show adult-oriented / less-filtered models (NSFW)" IsChecked="False" Checked="FeaturedNsfw_Changed" Unchecked="FeaturedNsfw_Changed" Foreground="{DynamicResource NexusSecondaryBrush}"/>
            <ItemsControl x:Name="FeaturedCards" Visibility="Collapsed" ItemTemplate="{StaticResource FeaturedModelCard}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="GuidedSetupTab" Header="Install &amp; chat"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock x:Name="GuidedModelTitleText" Text="Install and chat" FontSize="{DynamicResource NexusFontSize30}" FontWeight="SemiBold"/>
            <TextBlock x:Name="GuidedStatusText" Text="Choose a model card to begin." Foreground="{DynamicResource NexusAccentBrush}" TextWrapping="Wrap" Margin="0,8,0,18"/>
            <Button Content="Open chat" Click="GuidedStartChat_Click" IsEnabled="{Binding IsEnabled, ElementName=GuidedStartChatButton}" Background="{DynamicResource NexusButtonBrush}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
            <ProgressBar x:Name="GuidedProgress" Height="6" Minimum="0" Maximum="100" Margin="0,0,0,16"/>
            <Border Style="{StaticResource PanelStyle}"><Expander x:Name="GuidedModelStep" Header="1 · Model download" IsExpanded="True" Foreground="{DynamicResource NexusTextBrush}"><StackPanel>
                <DockPanel Margin="0,12,0,10"><Button x:Name="GuidedChooseFolderButton" Content="Choose folder" Click="GuidedChooseFolder_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="GuidedModelFolderText" ToolTip="Existing folder for model data" TextChanged="GuidedInputsChanged"/></DockPanel>
                <Button x:Name="GuidedReviewButton" Content="Check download size and fit" Click="GuidedReview_Click" HorizontalAlignment="Left"/>
                <Expander Header="Source, license and file details" Foreground="{DynamicResource NexusMutedBrush}" Margin="0,12,0,10"><TextBox x:Name="GuidedModelDetailsText" IsReadOnly="True" Height="145" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander>
                <Button Content="Read model card and license" Click="GuidedLicense_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
                <CheckBox x:Name="GuidedModelApprovalCheck" Foreground="{DynamicResource NexusTextBrush}" Checked="GuidedApproval_Changed" Unchecked="GuidedApproval_Changed"><TextBlock Text="I accept the displayed source license terms and approve this exact model download and destination." TextWrapping="Wrap"/></CheckBox>
                <Button x:Name="GuidedDownloadButton" Content="Download model" Click="GuidedDownload_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"/>
            </StackPanel></Expander></Border>
            <Border Style="{StaticResource PanelStyle}"><Expander x:Name="GuidedEngineStep" Header="2 · Local engine" IsExpanded="True" Foreground="{DynamicResource NexusTextBrush}"><StackPanel>
                <TextBlock Text="Use an existing llama.cpp engine, or get the portable CPU engine below. CPU inference is slower; GPU acceleration depends on your selected engine." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,10"/>
                <DockPanel><Button Content="Use existing engine" Click="GuidedRuntimeBrowse_Click" DockPanel.Dock="Right" Margin="10,0,0,0"/><TextBox x:Name="GuidedRuntimePathText" ToolTip="llama-server.exe path" TextChanged="GuidedRuntimePath_Changed"/></DockPanel>
                <TextBlock x:Name="GuidedRuntimeStatusText" Foreground="{DynamicResource NexusAccentBrush}" TextWrapping="Wrap" Margin="0,8,0,8"/>
                <Button x:Name="GuidedRuntimeReviewButton" Content="Review portable CPU engine" Click="GuidedRuntimeReview_Click" HorizontalAlignment="Left"/>
                <TextBox x:Name="GuidedRuntimeDetailsText" IsReadOnly="True" Height="125" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,10,0,8"/>
                <CheckBox x:Name="GuidedRuntimeDownloadApprovalCheck" Foreground="{DynamicResource NexusTextBrush}" Checked="GuidedRuntimeApproval_Changed" Unchecked="GuidedRuntimeApproval_Changed"><TextBlock Text="I accept the displayed upstream license and approve this exact runtime archive download." TextWrapping="Wrap"/></CheckBox>
                <Button x:Name="GuidedRuntimeDownloadButton" Content="Download engine archive" Click="GuidedRuntimeDownload_Click" HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,10"/>
                <CheckBox x:Name="GuidedRuntimeInstallApprovalCheck" Foreground="{DynamicResource NexusTextBrush}" Checked="GuidedRuntimeApproval_Changed" Unchecked="GuidedRuntimeApproval_Changed"><TextBlock Text="I accept the displayed upstream and bundled license terms and approve extracting these exact files into the new folder shown." TextWrapping="Wrap"/></CheckBox>
                <Button x:Name="GuidedRuntimeInstallButton" Content="Install portable engine" Click="GuidedRuntimeInstall_Click" HorizontalAlignment="Left" IsEnabled="False" Margin="0,8,0,0"/>
            </StackPanel></Expander></Border>
            <WrapPanel Margin="0,10,0,12"><Button x:Name="GuidedStartChatButton" Content="3 · Load model and open chat" Click="GuidedStartChat_Click" IsEnabled="False" Background="{DynamicResource NexusButtonBrush}"/><Button x:Name="GuidedCancelButton" Content="Cancel current step" Click="GuidedCancel_Click" IsEnabled="False" Margin="12,0,0,0"/></WrapPanel>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="ImageArtifactSetupTab" Header="Image file download"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock Text="Review image file download" FontSize="{DynamicResource NexusFontSize28}" FontWeight="SemiBold"/>
            <TextBlock x:Name="ImageArtifactSetupTitleText" Text="No image file selected" FontSize="{DynamicResource NexusFontSize22}" Margin="0,12,0,8" TextWrapping="Wrap"/>
            <TextBlock Text="A source file is not automatically a complete checkpoint or a working installation. Hardware fit, required companion files and runtime support remain unverified." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18"/>
            <TextBlock Text="Destination folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,12"><Button x:Name="ImageArtifactBrowseButton" Content="Choose existing folder" DockPanel.Dock="Right" Click="ImageArtifactBrowseButton_Click" Margin="10,0,0,0"/><TextBox x:Name="ImageArtifactDestinationText" TextChanged="ImageArtifactDestinationChanged" ToolTip="Explicitly choose an existing local folder for the selected file; no default location is chosen"/></DockPanel>
            <Button x:Name="ImageArtifactReviewButton" Content="Review exact file download" Click="ImageArtifactReviewButton_Click" IsEnabled="False" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBox x:Name="ImageArtifactSetupDetailsText" Text="Select an image file yourself in Discover. No file or download is selected by opening this page." IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" MinHeight="240" Height="320"/>
            <CheckBox x:Name="ImageArtifactApprovalCheck" IsChecked="False" IsEnabled="False" Checked="ImageArtifactApprovalChanged" Unchecked="ImageArtifactApprovalChanged" Foreground="{DynamicResource NexusTextBrush}" Margin="0,16,0,12"><TextBlock Text="I have reviewed the displayed source and license terms and approve only this exact image-file transfer or matching-file verification at the shown destination. This does not approve engine installation, configuration or model launch." TextWrapping="Wrap"/></CheckBox>
            <WrapPanel><Button x:Name="ImageArtifactDownloadButton" Content="Download approved file" ToolTip="Downloads the approved file, or verifies a matching existing file when the exact review permits reuse" IsEnabled="False" Click="ImageArtifactDownloadButton_Click"/><Button x:Name="ImageArtifactCancelButton" Content="Cancel current step" IsEnabled="False" Click="ImageArtifactCancelButton_Click" Margin="10,0,0,0"/><Button x:Name="ImageArtifactConnectFolderButton" Content="Choose tool / connect folder" IsEnabled="False" Click="ImageArtifactConnectFolderButton_Click" Margin="10,0,0,0" ToolTip="Choose an image tool first; folder configuration requires a separate review and approval"/></WrapPanel>
            <ProgressBar x:Name="ImageArtifactSetupProgress" Height="10" Maximum="100" Margin="0,16,0,10"/>
            <TextBlock x:Name="ImageArtifactSetupStatusText" Text="No image file has been selected or downloaded." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap"/>
        </StackPanel></ScrollViewer></TabItem>
        <TabItem x:Name="ComfyCheckpointFoldersTab" Header="Connect folders"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="28">
            <TextBlock Text="Connect image model folders" FontSize="{DynamicResource NexusFontSize28}" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock Text="Review a connection for an already installed ComfyUI engine. Approval writes only the displayed app-owned configuration and reviewed backup. Existing YAML is preserved. The connection applies on a separate next engine start; no checkpoint is selected or proven complete or compatible." Foreground="{DynamicResource NexusMutedBrush}" TextWrapping="Wrap" Margin="0,12,0,18"/>
            <TextBlock Text="Existing ComfyUI engine folder" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,12"><Button x:Name="ComfyFolderEngineBrowseButton" Content="Choose engine folder" DockPanel.Dock="Right" Click="ComfyFolderEngineBrowseButton_Click" Margin="10,0,0,0"/><TextBox x:Name="ComfyFolderEngineText" MaxLength="32767" TextChanged="ComfyFolderInputsChanged"/></DockPanel>
            <TextBlock Text="Existing checkpoint folders — one folder per line" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel Margin="0,0,0,12"><Button x:Name="ComfyFolderAddButton" Content="Add folder" DockPanel.Dock="Right" Click="ComfyFolderAddButton_Click" Margin="10,0,0,0"/><TextBox x:Name="ComfyFolderPathsText" Height="90" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="32768" TextChanged="ComfyFolderInputsChanged"/></DockPanel>
